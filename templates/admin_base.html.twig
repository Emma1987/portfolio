<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{{ 'admin.title'|trans({}, 'admin', 'en') }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">

    {% block stylesheets %}
        {{ encore_entry_link_tags('admin') }}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Lato:wght@100;300&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('admin') }}
    {% endblock %}
</head>
<body>
    {% if app.user %}
        <header>
            <div {{ stimulus_controller('menu') }}>
                <div role="button"
                     tabindex="0"
                     aria-label="Toggle menu"
                     class="menu-toggle"
                     {{ stimulus_action('menu', 'toggle', 'click') }}
                >
                    <i class="fa-solid fa-bars"></i>
                </div>
                <nav {{ stimulus_target('menu', 'menu') }}>
                    <ul class="nav-links">
                        <li class="{{ is_menu_active(constant('App\\Twig\\MenuExtension::HOME')) ? 'active' : '' }}">
                            <a href="{{ path('em_portfolio_backend') }}">{{ 'navigation.home'|trans({}, 'admin') }}</a>
                        </li>
                        <li class="{{ is_menu_active(constant('App\\Twig\\MenuExtension::PROJECTS')) ? 'active' : '' }}">
                            <a href="{{ path('em_portfolio_projects_list') }}">{{ 'navigation.projects'|trans({}, 'admin') }}</a>
                        </li>
                        <li class="{{ is_menu_active(constant('App\\Twig\\MenuExtension::TECHNOLOGIES')) ? 'active' : '' }}">
                            <a href="{{ path('em_portfolio_technologies_list') }}">{{ 'navigation.technologies'|trans({}, 'admin') }}</a>
                        </li>
                        <li class="{{ is_menu_active(constant('App\\Twig\\MenuExtension::COMPANIES')) ? 'active' : '' }}">
                            <a href="{{ path('em_portfolio_companies_list') }}">{{ 'navigation.companies'|trans({}, 'admin') }}</a>
                        </li>
                        <li class="{{ is_menu_active(constant('App\\Twig\\MenuExtension::TOOLBOX')) ? 'active' : '' }}">
                            <a href="{{ path('em_portfolio_backend_toolbox') }}">{{ 'navigation.tool_box'|trans({}, 'admin') }}</a>
                        </li>
                        <li>
                            <a href="{{ path('em_portfolio_backend_logout') }}" data-turbo="false">
                                {{ 'navigation.logout'|trans({}, 'admin') }}
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>
    {% endif %}

    <main {{ stimulus_controller('confirm-modal') }}>
        {% block body_title %}<h1>{{ 'admin.title'|trans({}, 'admin') }}</h1>{% endblock %}

        <turbo-frame id="flash-message-container">
            {% for message in app.flashes('success') %}
                <twig:Alert message="{{ message }}" type="success" :autoDismiss="true" />
            {% endfor %}

            {% for message in app.flashes('error') %}
                <twig:Alert message="{{ message }}" type="danger" :autoDismiss="true" />
            {% endfor %}
        </turbo-frame>

        {% block body %}{% endblock %}

        {% block confirm_modal %}
            <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="Confirm Modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div class="modal-title fs-5 fw-bold space-grotesk" {{ stimulus_target('confirm-modal', 'title') }}></div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body my-3" {{ stimulus_target('confirm-modal', 'body') }}></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                {{ 'confirm_modal.cancel'|trans({}, 'admin') }}
                            </button>
                            <a href="#" class="btn btn-primary" {{ stimulus_target('confirm-modal', 'confirmButton') }}>
                                {{ 'confirm_modal.confirm'|trans({}, 'admin') }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    </main>
</body>
</html>
