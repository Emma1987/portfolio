<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{{ 'meta.title'|trans }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Emmanuelle Mercadal">
    <meta name="description" content="{{ 'meta.description'|trans }}">
    <meta name="robots" content="noindex, nofollow">

    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">

    <!-- Open Graph -->
    <meta property="og:title" content="{{ 'meta.title'|trans }}">
    <meta property="og:description" content="{{ 'meta.description'|trans }}">
    <meta property="og:image" content="https://e-mercadal.com/images/illustration.png">
    <meta property="og:url" content="https://e-mercadal.com">
    <meta property="og:type" content="website">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ 'meta.title'|trans }}">
    <meta name="twitter:description" content="{{ 'meta.description'|trans }}">
    <meta name="twitter:image" content="https://e-mercadal.com/images/illustration.png">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
    <header>
        <div id="pre-header">
            <div class="dropdown">
                <button class="btn btn-light btn-sm dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ app.request.locale == 'en' ? 'header.language.english'|trans : 'header.language.french'|trans }}
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                    <li>
                        <a class="dropdown-item" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({_locale: 'en'})) }}">
                            {{ 'header.language.english'|trans }}
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({_locale: 'fr'})) }}">
                            {{ 'header.language.french'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div id="header">
            <a href="{{ path('em_portfolio_home') }}">
                <div class="title press-start-2p-regular">{{ 'header.name'|trans }}</div>
                <div class="sub-title press-start-2p-regular">{{ 'header.title'|trans }}</div>
                <div class="sub-sub-title press-start-2p-regular">{{ 'header.sub_title'|trans }}</div>
            </a>
        </div>

        <nav id="navigation">
            <a href="{{ path('em_portfolio_projects') }}">
                <img src="{{ asset('/images/icons/projects.png') }}" alt="See my projects">
                <p>{{ 'header.nav.projects'|trans }}</p>
            </a>
            <a href="{{ path('em_portfolio_about') }}">
                <img src="{{ asset('/images/icons/about.png') }}" alt="Know about me">
                <p>{{ 'header.nav.about'|trans }}</p>
            </a>
            <a href="{{ path('em_portfolio_contact') }}">
                <img src="{{ asset('/images/icons/contact.png') }}" alt="Contact me">
                <p>{{ 'header.nav.contact'|trans }}</p>
            </a>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer>
        <p>{{ 'footer'|trans({'%date%': 'now'|date('Y')})|raw }}</p>
    </footer>
</body>
</html>
