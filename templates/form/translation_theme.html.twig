{% block _translations_translations_widget %}
    <div class="translations-row">
        {# Header row: render field labels manually #}
        <div class="translation-label" style="display: flex; gap: 1rem;">
            <label style="flex: 0 0 140px;">{{ form[0].entity.vars.label|trans }}</label>
            <label style="flex: 0 0 140px;">{{ form[0].field.vars.label|trans }}</label>
            <label style="flex: 1;">{{ form[0].fr_translation.vars.label|trans }}</label>
            <label style="flex: 1;">{{ form[0].en_translation.vars.label|trans }}</label>
        </div>

        {# Data rows: render each translation without labels #}
        <div class="translations-row" style="display: flex; flex-direction: column; gap: .5rem;">
            {% for child in form %}
                <div class="translation-entry" style="display: flex; gap: 1rem;">
                    <div style="flex: 0 0 140px;">{{ form_widget(child.entity) }}</div>
                    <div style="flex: 0 0 140px;">{{ form_widget(child.field) }}</div>
                    <div style="flex: 1;">{{ form_widget(child.fr_translation) }}</div>
                    <div style="flex: 1;">{{ form_widget(child.en_translation) }}</div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
