{% extends 'admin_base.html.twig' %}

{% block body_title %}
    <h1 class="d-flex">{{ 'admin.title'|trans({}, 'admin') }}<twig:ux:icon name="icon-park-outline:game" class="ux-icon ms-2" /></h1>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="custom-card custom-card-green card-large">
            {{ 'recruiter_game.index_quote'|trans({}, 'admin') }}
        </div>
        <div class="custom-card custom-card-yellow card-small">
            <a href="{{ path('em_portfolio_recruiter_game_add') }}">
                <twig:ux:icon name="iconoir:add-circle" class="ux-icon" /><br>{{ 'recruiter_game.add_question'|trans({}, 'admin') }}
            </a>
        </div>
    </div>

    <hr class="my-4">

    {% if questions|length > 0 %}
        <section class="question-cards">
            {% for question in questions %}
                {{ include('admin/recruiter-game/_question.html.twig') }}
            {% endfor %}
        </section>
    {% else %}
        <div class="d-flex justify-content-center custom-card custom-card-pink mb-3">
            <div>{{ 'recruiter_game.list.empty'|trans({}, 'admin') }}</div>
        </div>
    {% endif %}
{% endblock %}
