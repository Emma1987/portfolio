{% extends 'admin_base.html.twig' %}

{% block body_title %}
    <h1 class="d-flex">{{ 'admin.title'|trans({}, 'admin') }}<twig:ux:icon name="fa-solid:mug-hot" class="ux-icon ms-2" /></h1>
{% endblock %}

{% block body %}
    <div class="custom-card custom-card-pink text-center">
        {{ 'companies.list_quote'|trans({}, 'admin') }}
    </div>

    <hr class="my-4">

    <section class="companies-card">
        {# Add company form #}
        <div class="custom-card custom-card-blue mb-3">
            <div class="h5 text-center text-uppercase space-grotesk">
                {{ 'companies.form.title'|trans({}, 'admin') }}
            </div>

            <hr>

            {{ form_start(form, {action: path('em_portfolio_companies_add')}) }}
                <div class="d-flex">
                    <div class="flex-grow-1 me-2">
                        {{ form_rest(form) }}
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary mb-3">
                        {{ 'companies.form.submit'|trans({}, 'admin') }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>

        {# Sort companies form #}
        <div class="custom-card custom-card-yellow mb-3">
            <div class="h5 text-center text-uppercase space-grotesk">
                {{ 'companies.list.title'|trans({}, 'admin') }}
            </div>

            <hr>

            {% if companies|length > 0 %}
                <div {{ stimulus_controller('sortable-list') }}>
                    {{ form_start(sort_form, {action: path('em_portfolio_companies_sort')}) }}
                        <ul class="sortable-list" {{ stimulus_target('sortable-list', 'list') }}>
                            {% for company_form in sort_form.companies %}
                                <li {{ stimulus_target('sortable-list', 'item') }}>
                                    {{ form_widget(company_form.name) }}
                                    {{ form_widget(company_form.position) }}
                                    <div class="company-name">
                                        <twig:ux:icon name="pixel:sort" class="ux-icon" /> {{ company_form.vars.data.name }}
                                    </div>
                                    <button
                                        type="button"
                                        class="delete-icon"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmModal"
                                        {{ stimulus_action('confirm-modal', 'open') }}
                                        data-title="{{ 'companies.delete.modal_title'|trans({}, 'admin') }}"
                                        data-body="{{ 'companies.delete.modal_body'|trans({'%name%': company_form.vars.data.name}, 'admin') }}"
                                        data-confirm-url="{{ path('em_portfolio_companies_delete', {id: company_form.vars.data.id}) }}"
                                    >
                                        <twig:ux:icon name="material-symbols:delete-outline" class="ux-icon" data-action="confirm-modal#open" />
                                    </button>

                                </li>
                            {% endfor %}
                        </ul>
                        <button type="submit" class="btn btn-sm btn-secondary mb-3">
                            {{ 'companies.list.save_list'|trans({}, 'admin') }}
                        </button>
                    {{ form_end(sort_form) }}
                </div>
            {% else %}
                <p class="text-center">
                    {{ 'companies.list.empty'|trans({}, 'admin') }}
                </p>
            {% endif %}
        </div>
    </section>
{% endblock %}
