{% extends 'admin_base.html.twig' %}
{% trans_default_domain 'admin' %}

{% block body_title %}
    <h1 class="d-flex">{{ 'admin.title'|trans }}<twig:ux:icon name="icon-park-outline:game" class="ux-icon ms-2" /></h1>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="custom-card custom-card-green card-large">
            {{ 'recruiter_game.add_quote'|trans }}
        </div>
        <div class="custom-card custom-card-yellow card-small">
            <a href="{{ path('em_portfolio_recruiter_game_index') }}">
                <twig:ux:icon name="fluent-mdl2:navigate-back" class="ux-icon" /><br>{{ 'recruiter_game.back_to_list'|trans }}
            </a>
        </div>
    </div>

    <hr>

    <section class="question-form">
        <div class="custom-card custom-card-pink">
            <div class="space-grotesk d-flex justify-content-center fw-bold text-uppercase mb-3">
                {% block project_form_title %}
                    {{ 'recruiter_game.form.title'|trans }}
                {% endblock %}
            </div>

            {{ form_start(form) }}
            {{ form_row(form.question) }}
            {{ form_row(form.answer) }}
            {{ form_row(form.category) }}

            <button type="submit" class="btn btn-sm btn-secondary">
                {% if edit %}
                    {{ 'recruiter_game.form.edit'|trans }}
                {% else %}
                    {{ 'recruiter_game.form.add'|trans }}
                {% endif %}
            </button>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
