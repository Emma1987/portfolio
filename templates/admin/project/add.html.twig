{% extends 'admin_base.html.twig' %}

{% block body_title %}
    <h1 class="d-flex">{{ 'admin.title'|trans({}, 'admin') }}<twig:ux:icon name="lucide:brain" class="ux-icon ms-2" /></h1>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="custom-card custom-card-blue card-large">
            {{ 'projects.add_quote'|trans({}, 'admin') }}
        </div>
        <div class="custom-card custom-card-yellow card-small">
            <a href="{{ path('em_portfolio_project_list') }}">
                <twig:ux:icon name="fluent-mdl2:navigate-back" class="ux-icon" /><br>{{ 'projects.back_to_list'|trans({}, 'admin') }}
            </a>
        </div>
    </div>

    <hr>

    <section class="project-form">
        <div class="custom-card custom-card-pink">
            <div class="space-grotesk d-flex justify-content-center fw-bold text-uppercase mb-3">
                {% block project_form_title %}
                    {{ 'projects.form.title'|trans({}, 'admin') }}
                {% endblock %}
            </div>

            {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
            {{ form_row(form.title) }}
            {{ form_row(form.summary) }}
            {{ form_row(form.description) }}

            <hr class="my-4 invisible">

            {{ form_row(form.technologies) }}
            {{ form_row(form.tags) }}
            {{ form_row(form.companies) }}
            {{ form_row(form.level) }}

            <hr class="my-4 invisible">

            {% block project_form_pictures %}{% endblock %}
            {{ form_row(form.pictures) }}

            <button type="submit" class="btn btn-sm btn-secondary">
                {% block project_form_button %}
                    {{ 'projects.form.add'|trans({}, 'admin') }}
                {% endblock %}
            </button>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
