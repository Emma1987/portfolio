{% set classes = ['custom-card-blue', 'custom-card-green', 'custom-card-yellow', 'custom-card-pink'] %}
{% set random_class = random(classes) %}
{% set btn_class = random_class == 'custom-card-pink' or random_class == 'custom-card-yellow' ? 'btn-secondary' : 'btn-primary' %}

<div class="custom-card {{ random_class }}">
    <p class="h4 fw-bold">{{ project.title }}</p>
    <p>{{ project.summary }}</p>

    {{ 'projects.technologies'|trans({}, 'admin') }}
    <ul>
        {% for technology in project.projectTechnologies %}
            <li>{{ technology.technology.name }}</li>
        {% endfor %}
    </ul>

    {{ 'projects.tags'|trans({}, 'admin') }}
    <ul>
        {% for tag in project.projectTags %}
            <li>{{ tag.tag.name }}</li>
        {% endfor %}
    </ul>

    {{ 'projects.pictures'|trans({}, 'admin') }}
    <div class="d-flex w-auto mb-3">
        {% for picture in project.pictures %}
            <button
                class="open-picture-modal-button w-25 me-2"
                data-bs-toggle="modal"
                data-bs-target="#viewPictureModal"
                {{ stimulus_action('picture-modal', 'open') }}
                data-img-src="{{ asset('images/project/' ~ picture.path) }}"
            >
                <img src="{{ asset('images/project/' ~ picture.path) }}" alt="Project picture" class="w-100" />
            </button>
        {% endfor %}
    </div>

    <p><em>
        {{ 'projects.built_for'|trans({'%companies%': project.companies|map(company => company.name)|join(', ')}, 'admin') }}
    </em></p>

    <hr>

    <div class="d-flex justify-content-around">
        <a href="#" class="btn btn-sm {{ btn_class }}">
            {{ 'projects.preview_project'|trans({}, 'admin') }}
        </a>
        <a href="{{ path('em_portfolio_project_edit', {id: project.id}) }}" class="btn btn-sm {{ btn_class }}">
            {{ 'projects.edit_project'|trans({}, 'admin') }}
        </a>
        <button
            class="btn btn-sm {{ btn_class }}"
            data-bs-toggle="modal"
            data-bs-target="#confirmModal"
            {{ stimulus_action('confirm-modal', 'open') }}
            data-title="{{ 'projects.delete.modal_title'|trans({}, 'admin') }}"
            data-body="{{ 'projects.delete.modal_body'|trans({'%title%': project.title}, 'admin') }}"
            data-confirm-url="{{ path('em_portfolio_project_delete', {id: project.id}) }}"
        >
            {{ 'projects.delete_project'|trans({}, 'admin') }}
        </button>
    </div>
</div>
