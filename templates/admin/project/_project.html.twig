{% trans_default_domain 'admin' %}

<div class="custom-card {% if project.featured %}featured{% elseif project.isHidden %}hidden{% else %}custom-card-light{% endif %}">
    <p class="h4 fw-bold">{{ project.title }}</p>
    <p>{{ project.summary }}</p>

    {{ 'projects.technologies'|trans }}
    <ul>
        {% for technology in project.projectTechnologies %}
            <li>{{ technology.technology.name }}</li>
        {% endfor %}
    </ul>

    {{ 'projects.tags'|trans }}
    <ul>
        {% for tag in project.projectTags %}
            <li>{{ tag.tag.name }}</li>
        {% endfor %}
    </ul>

    {{ 'projects.pictures'|trans }}
    <div class="d-flex w-auto mb-3">
        {% for picture in project.pictures %}
            <button
                class="open-picture-modal-button w-25 me-2"
                data-bs-toggle="modal"
                data-bs-target="#viewPictureModal"
                {{ stimulus_action('picture-modal', 'open') }}
                data-img-src="{{ asset('images/project/' ~ picture.path) }}"
            >
                <img src="{{ asset('images/project/' ~ picture.path) }}" alt="Project picture" class="w-100" />
            </button>
        {% endfor %}
    </div>

    <p><em>
        {{ 'projects.built_for'|trans({companies: project.companies|map(company => company.name)|join(', ')}) }}
    </em></p>

    <hr>

    <div class="d-flex justify-content-around mb-2">
        <button
            class="btn btn-sm btn-tertiary"
            data-bs-toggle="modal"
            data-bs-target="#confirmModal"
            {{ stimulus_action('confirm-modal', 'open') }}
            data-title="{{ (project.isFeatured ? 'projects.remove_highlight.modal_title' : 'projects.highlight.modal_title')|trans }}"
            data-body="{{ (project.isFeatured ? 'projects.remove_highlight.modal_body' : 'projects.highlight.modal_body')|trans({title: project.title}) }}"
            data-confirm-url="{{ path('em_portfolio_project_highlight', {id: project.id}) }}"
        >
            {{ (project.isFeatured ? 'projects.remove_highlight_project' : 'projects.highlight_project')|trans }}
        </button>
        <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#confirmModal"
            {{ stimulus_action('confirm-modal', 'open') }}
            data-title="{{ (project.isHidden ? 'projects.remove_hidden.modal_title' : 'projects.hide.modal_title')|trans }}"
            data-body="{{ (project.isHidden ? 'projects.remove_hidden.modal_body' : 'projects.hide.modal_body')|trans({title: project.title}) }}"
            data-confirm-url="{{ path('em_portfolio_project_hide', {id: project.id}) }}"
        >
            {{ (project.isHidden ? 'projects.remove_hidden_project' : 'projects.hide_project')|trans }}
        </button>
    </div>
    <div class="d-flex justify-content-around">
        <a href="{{ path('em_portfolio_project_preview', {id: project.id}) }}" class="btn btn-sm btn-secondary">
            {{ 'projects.preview_project'|trans }}
        </a>
        <a href="{{ path('em_portfolio_project_edit', {id: project.id}) }}" class="btn btn-sm btn-secondary">
            {{ 'projects.edit_project'|trans }}
        </a>
        <button
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#confirmModal"
            {{ stimulus_action('confirm-modal', 'open') }}
            data-title="{{ 'projects.delete.modal_title'|trans }}"
            data-body="{{ 'projects.delete.modal_body'|trans({title: project.title}) }}"
            data-confirm-url="{{ path('em_portfolio_project_delete', {id: project.id}) }}"
        >
            {{ 'projects.delete_project'|trans }}
        </button>
    </div>
</div>
