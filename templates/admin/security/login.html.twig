{% extends 'admin_base.html.twig' %}
{% trans_default_domain 'admin' %}

{% block body_title %}<h1 class="text-center">{{ 'admin.title'|trans }}</h1>{% endblock %}

{% block body %}
    <div class="custom-card custom-card-green login-card">
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">
                    <i class="fa-regular fa-circle-xmark"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3 alert alert-success">
                    {{ 'login.logged_in'|trans({name: app.user.name}) }}
                </div>
            {% endif %}

            <h2 class="h3 mb-3 text-center">{{ 'login.title'|trans }}</h2>

            <div class="mb-3">
                <label for="username">{{ 'login.label.email'|trans }}</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email"  autofocus>
            </div>

            <div class="mb-3">
                <label for="password">{{ 'login.label.password'|trans }}</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password"  >
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">{{ 'login.label.remember_me'|trans }}</label>
            </div>

            <button class="btn btn-primary mt-3" type="submit">
                {{ 'login.submit'|trans }}
            </button>
        </form>
    </div>
{% endblock %}
