{% extends 'admin_base.html.twig' %}
{% trans_default_domain 'admin' %}

{% block body_title %}
    <h1 class="d-flex">{{ 'admin.title'|trans }}<twig:ux:icon name="lucide:bug" class="ux-icon ms-2" /></h1>
{% endblock %}

{% block body %}
    <div class="custom-card custom-card-green text-center">
        {{ 'tags.list_quote'|trans }}
    </div>

    <hr class="my-4">

    <section class="tags-card">
        {# Add tag form #}
        <div class="custom-card custom-card-yellow mb-3">
            <div class="h5 text-center text-uppercase space-grotesk">
                {{ 'tags.form.title'|trans }}
            </div>

            <hr>

            {{ form_start(form, {action: path('em_portfolio_tag_add')}) }}
                <div class="d-flex">
                    <div class="flex-grow-1 me-2">
                        {{ form_rest(form) }}
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary mb-3">
                        {{ 'tags.form.submit'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>

        {# Sort tags form #}
        <twig:SortableCard
            title="{{ 'tags.list.title'|trans }}"
            color="pink"
            :form="sort_form"
            :list="tags"
            formFieldName="tags"
            sortRoute="em_portfolio_tag_list"
            deleteRouteName="em_portfolio_tag_delete"
            :translations="{
                delete_title: 'tags.delete.modal_title',
                delete_body: 'tags.delete.modal_body',
                save_list: 'tags.list.save_list',
                empty: 'tags.list.empty'
            }"
        />
    </section>
{% endblock %}
