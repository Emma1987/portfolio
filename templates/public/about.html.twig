{% extends 'base.html.twig' %}

{% block body %}
    <section id="about" class="py-5">
        <h2 class="title press-start-2p-regular">
            <span class="mt-1">{{ 'about.intro_title'|trans }}</span>
            <span>👩‍💻</span>
        </h2>
        <p class="justify">{{ 'about.intro_text1'|trans }}</p>
        <p class="justify">{{ 'about.intro_text2'|trans }}</p>

        <hr>

        <h2 class="title press-start-2p-regular">
            <span class="mt-1">{{ 'about.learning_title'|trans }}</span>
            <span>🧠</span>
        </h2>
        <p class="justify">
            {{ 'about.learning_text'|trans({
                '%link%': '<a href="https://openclassrooms.com/paths/59-developpeur-dapplication-php-symfony" target="_blank">OpenClassrooms</a>',
            })|raw }}
        </p>

        <hr>

        <h2 class="title press-start-2p-regular">
            <span class="mt-1">{{ 'about.tools_title'|trans }}</span>
            <span>🧰</span>
        </h2>
        <p class="justify">
            {{ 'about.tools_languages'|trans({
                '%languages%': tools|filter(tool => tool.category == constant('App\\Entity\\Enum\\ToolCategory::LANGUAGES'))|map(tool => tool.name)|join('</li><li>'),
            })|raw }}
        </p>
        <p class="justify">
            {{ 'about.tools_frameworks'|trans({
                '%frameworks%': tools|filter(tool => tool.category == constant('App\\Entity\\Enum\\ToolCategory::FRAMEWORKS'))|map(tool => tool.name)|join('</li><li>'),
            })|raw }}
        </p>
        <p class="justify">
            {{ 'about.tools_tools'|trans({
                '%tools%': tools|filter(tool => tool.category == constant('App\\Entity\\Enum\\ToolCategory::TOOLS'))|map(tool => tool.name)|join('</li><li>'),
            })|raw }}
        </p>
        <p class="justify">
            {{ 'about.tools_practices'|trans({
                '%practices%': tools|filter(tool => tool.category == constant('App\\Entity\\Enum\\ToolCategory::PRACTICES'))|map(tool => tool.name)|join('</li><li>'),
            })|raw }}
        </p>
        <p class="justify">
            {{ 'about.tools_text'|trans|raw }}
        </p>

        <p class="justify pt-3">{{ 'about.outro'|trans }}</p>

        <div class="xp-bar my-5 text-center">
            <div class="progress-bar-title press-start-2p-regular">
                {{ 'about.progress_bar'|trans }}
            </div>
            <div class="xp-bar-container">
                <div class="xp-bar-fill"></div>
            </div>
        </div>

        <p>{{ 'about.recruiter_game'|trans({'%link%': path('em_portfolio_recruiter_game')})|raw }}</p>
    </section>
{% endblock %}
